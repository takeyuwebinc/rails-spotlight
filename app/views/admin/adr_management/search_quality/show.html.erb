<% content_for(:title) { "検索品質" } %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-zinc-900">検索品質</h1>
</div>

<%# 概況（直近30日） %>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white shadow rounded-lg p-4">
    <p class="text-sm text-zinc-500">検索実行数（30日）</p>
    <p class="text-2xl font-bold text-zinc-900"><%= @summary[:total] %> 件</p>
    <p class="text-xs text-zinc-500">
      <%= @summary[:by_mode].map { |mode, count| "#{mode}: #{count}" }.join(" / ") %>
    </p>
  </div>
  <div class="bg-white shadow rounded-lg p-4">
    <p class="text-sm text-zinc-500">0件検索（30日）</p>
    <p class="text-2xl font-bold text-zinc-900"><%= @summary[:zero_result_count] %> 件</p>
  </div>
  <div class="bg-white shadow rounded-lg p-4">
    <p class="text-sm text-zinc-500">取り逃がし報告（30日）</p>
    <p class="text-2xl font-bold text-zinc-900"><%= @miss_report_count %> 件</p>
  </div>
  <div class="bg-white shadow rounded-lg p-4">
    <p class="text-sm text-zinc-500">最新 recall@<%= @evaluations.first&.k || 10 %></p>
    <p class="text-2xl font-bold text-zinc-900">
      <%= @evaluations.first ? format("%.3f", @evaluations.first.recall) : "未測定" %>
    </p>
  </div>
</div>

<%# レビューキュー: 0件検索 %>
<div class="bg-white shadow rounded-lg mb-6">
  <div class="px-4 py-3 border-b border-zinc-200">
    <h2 class="text-lg font-semibold text-zinc-900">レビュー待ち: 0件検索（<%= @pending_logs.size %> 件）</h2>
    <p class="text-sm text-zinc-500">関連 ADR が存在するのに検索が返せなかった（取り逃がし）かを判断してください。</p>
  </div>
  <% if @pending_logs.any? %>
    <ul class="divide-y divide-zinc-200">
      <% @pending_logs.each do |log| %>
        <li class="p-4">
          <div class="flex items-center gap-2 text-sm text-zinc-500 mb-1">
            <span><%= log.created_at.to_date %></span>
            <span class="rounded bg-zinc-100 px-2 py-0.5 text-xs"><%= log.mode %></span>
          </div>
          <p class="text-zinc-900 font-medium mb-3"><%= log.query.presence || log.keyword %></p>
          <div class="flex flex-wrap items-end gap-3">
            <%= form_with url: admin_adr_management_search_log_miss_report_path(log), method: :post, class: "flex flex-wrap items-end gap-2" do |f| %>
              <div>
                <label class="block text-xs text-zinc-500 mb-1">観測メモ（必須）</label>
                <%= f.text_field :note, required: true, placeholder: "例: keyword「payload」で到達。表記揺れ",
                      class: "w-72 rounded-md border-zinc-300 text-sm" %>
              </div>
              <div>
                <label class="block text-xs text-zinc-500 mb-1">到達 ADR 案件 code（任意）</label>
                <%= f.text_field :engagement_code, placeholder: "spotlight-rails",
                      class: "w-40 rounded-md border-zinc-300 text-sm" %>
              </div>
              <div>
                <label class="block text-xs text-zinc-500 mb-1">番号</label>
                <%= f.number_field :number, class: "w-20 rounded-md border-zinc-300 text-sm" %>
              </div>
              <%= f.submit "取り逃がしとして記録",
                    class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
            <% end %>
            <%= button_to "問題なし", admin_adr_management_search_log_review_path(log),
                  class: "rounded-md border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50 cursor-pointer" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="p-4 text-sm text-zinc-500">レビュー待ちの0件検索はありません。</p>
  <% end %>
</div>

<%# レビューキュー: 取り逃がし報告 %>
<div class="bg-white shadow rounded-lg mb-6">
  <div class="px-4 py-3 border-b border-zinc-200">
    <h2 class="text-lg font-semibold text-zinc-900">レビュー待ち: 取り逃がし報告（<%= @pending_reports.size %> 件）</h2>
    <p class="text-sm text-zinc-500">回帰テストに残す価値があればゴールデンクエリとして採用してください（クエリ文言は自然言語に編集可）。</p>
  </div>
  <% if @pending_reports.any? %>
    <ul class="divide-y divide-zinc-200">
      <% @pending_reports.each do |report| %>
        <li class="p-4">
          <div class="flex items-center gap-2 text-sm text-zinc-500 mb-1">
            <span><%= report.created_at.to_date %></span>
            <span>到達 ADR: <%= report.adr ? report.adr.display_number : "（未到達）" %></span>
          </div>
          <p class="text-zinc-900 font-medium">失敗クエリ: <%= report.query %></p>
          <p class="text-sm text-zinc-600 mb-3"><%= report.note %></p>
          <div class="flex flex-wrap items-end gap-3">
            <% if report.adr %>
              <%= form_with url: admin_adr_management_search_miss_report_golden_query_path(report), method: :post, class: "flex flex-wrap items-end gap-2" do |f| %>
                <div>
                  <label class="block text-xs text-zinc-500 mb-1">採用するクエリ（<%= report.adr.display_number %> が上位に出るべき問い）</label>
                  <%= f.text_field :query, value: report.query,
                        class: "w-96 rounded-md border-zinc-300 text-sm" %>
                </div>
                <%= f.submit "ゴールデンクエリとして採用",
                      class: "rounded-md bg-green-600 px-3 py-2 text-sm font-medium text-white hover:bg-green-500 cursor-pointer" %>
              <% end %>
            <% else %>
              <p class="text-sm text-zinc-500">到達 ADR がないため採用できません（期待 ADR を定められません）。</p>
            <% end %>
            <%= button_to "対応済みにする", admin_adr_management_search_miss_report_review_path(report),
                  class: "rounded-md border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50 cursor-pointer" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="p-4 text-sm text-zinc-500">レビュー待ちの取り逃がし報告はありません。</p>
  <% end %>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <%# recall 推移 %>
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-3 border-b border-zinc-200">
      <h2 class="text-lg font-semibold text-zinc-900">recall 推移</h2>
    </div>
    <table class="min-w-full divide-y divide-zinc-200">
      <thead class="bg-zinc-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-zinc-500">実行日時</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-zinc-500">recall@k</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-zinc-500">実行経路</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-200">
        <% if @evaluations.any? %>
          <% @evaluations.each do |evaluation| %>
            <tr>
              <td class="px-4 py-2 text-sm text-zinc-900"><%= evaluation.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-4 py-2 text-sm text-zinc-900"><%= format("%.3f", evaluation.recall) %> @<%= evaluation.k %></td>
              <td class="px-4 py-2 text-sm text-zinc-500"><%= evaluation.origin %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="3" class="px-4 py-4 text-sm text-zinc-500">評価履歴がありません。</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ゴールデンクエリ一覧 %>
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-3 border-b border-zinc-200">
      <h2 class="text-lg font-semibold text-zinc-900">ゴールデンクエリ（<%= @golden_queries.size %> 件）</h2>
    </div>
    <table class="min-w-full divide-y divide-zinc-200">
      <thead class="bg-zinc-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-zinc-500">クエリ</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-zinc-500">期待 ADR</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-200">
        <% if @golden_queries.any? %>
          <% @golden_queries.each do |golden_query| %>
            <tr>
              <td class="px-4 py-2 text-sm text-zinc-900"><%= golden_query.query %></td>
              <td class="px-4 py-2 text-sm text-zinc-500"><%= golden_query.adr.display_number %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="2" class="px-4 py-4 text-sm text-zinc-500">ゴールデンクエリがありません（import_golden_queries で移行するか、取り逃がし報告から採用してください）。</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
